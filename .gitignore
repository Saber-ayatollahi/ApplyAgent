# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/
build/
dist/

# ============================================================================
# IDE / OS
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================================
# Ephemeral output — regenerated by the agents
# ============================================================================
# Scan and scoring output
automation/outputs/scan_*.json
automation/outputs/scan_*.md
automation/outputs/scan_*_stderr.log
automation/outputs/*_scored.json
automation/outputs/*_scored.md
automation/outputs/SCAN_*.md
automation/outputs/promote_report_*.md
automation/outputs/weekly_report_*.md
automation/outputs/fit_scorer_stderr.log
automation/outputs/fit_scorer_progress.json
automation/outputs/runs/
automation/outputs/pipelines/

# Caches — regenerated on demand
automation/outputs/jd_cache/
automation/outputs/fit_cache/

# Tailor outputs — one per application; don't ship drafts
automation/outputs/*_prompt.md
automation/outputs/*_resume.md
automation/outputs/*_cover.md
automation/outputs/*_brief.md

# ============================================================================
# Tracker / CRM backups — written by auto_promote and the UI
# ============================================================================
job_tracker_data.bak*.json
recruiter_crm.bak*.json

# ============================================================================
# Secrets — never commit
# ============================================================================
.env
*.key
secrets.json

# ============================================================================
# But DO keep a placeholder so outputs/ exists after clone
# ============================================================================
!automation/outputs/.gitkeep
