# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/
build/
dist/

# ============================================================================
# IDE / OS
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================================
# Agent outputs — tracked so both machines stay in sync
# ============================================================================
# Intentionally NOT ignored (so they commit):
#   scan_*.json / scan_*.md           — scraper output
#   *_scored.json / *_scored.md       — fit-scorer output
#   SCAN_*.md                         — narrative reports
#   promote_report_*.md               — promote run summaries
#   weekly_report_*.md                — weekly retrospectives
#   runs/                             — background-run metadata + logs
#   pipelines/                        — pipeline status JSONs
#   *_prompt.md / *_resume.md / *_cover.md / *_brief.md  — tailor artifacts

# ============================================================================
# Ephemeral — too noisy or too large to track
# ============================================================================
# Stderr dumps
automation/outputs/scan_*_stderr.log
automation/outputs/fit_scorer_stderr.log

# Progress file — rewritten per candidate during scoring, churns the diff
automation/outputs/fit_scorer_progress.json

# Caches — can grow to many MB of JD text; regenerate on demand
automation/outputs/jd_cache/
automation/outputs/fit_cache/

# ============================================================================
# Tracker / CRM backups — written by auto_promote and the UI
# ============================================================================
job_tracker_data.bak*.json
recruiter_crm.bak*.json

# ============================================================================
# Secrets — NEVER commit
# ============================================================================
.env
*.key
secrets.json

# ============================================================================
# But DO keep a placeholder so outputs/ exists after clone
# ============================================================================
!automation/outputs/.gitkeep
