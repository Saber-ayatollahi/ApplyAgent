# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/
build/
dist/

# ============================================================================
# IDE / OS
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================================
# Claude Code agent worktrees — local-only checkouts, each with its own .git
# ============================================================================
.claude/worktrees/

# Review-agent scratch dirs (E2E drills, migration probes, etc.). Each agent
# writes its harness scripts here; nothing inside is meant to be sourced or
# imported by the real codebase.
.tmp_e2e/
.tmp_e2e_round2/
.tmp_migration_drill/
.tmp_*/

# ============================================================================
# Agent outputs — tracked so both machines stay in sync
# ============================================================================
# Intentionally NOT ignored (so they commit):
#   scan_*.json / scan_*.md           — scraper output
#   *_scored.json / *_scored.md       — fit-scorer output
#   SCAN_*.md                         — narrative reports
#   promote_report_*.md               — promote run summaries
#   weekly_report_*.md                — weekly retrospectives
#   runs/                             — background-run metadata + logs
#   pipelines/                        — pipeline status JSONs
#   *_prompt.md / *_resume.md / *_cover.md / *_brief.md  — tailor artifacts

# ============================================================================
# Ephemeral — too noisy or too large to track
# ============================================================================
# Stderr dumps
automation/outputs/scan_*_stderr.log
automation/outputs/fit_scorer_stderr.log

# Repair-script sidecar backups (worklist*.bak.<stamp>.json). These are
# safety copies written by automation/repair_misparsed_rows.py before any
# in-place edit; they're per-machine + recoverable from git history if
# ever needed. Don't commit — they bloat the diff and never get read.
automation/outputs/*.bak.*.json

# Progress file — rewritten per candidate during scoring, churns the diff
automation/outputs/fit_scorer_progress.json

# Standalone triage preview — written by the ③ Triage "Run triage (free)"
# button (fit_scorer --dry-run --triage-out). Pure UI scratch: regenerated on
# every click, has NO downstream consumer (the promoter reads worklist_scored
# .json, not this). Don't commit — it'd churn the diff like the progress file.
automation/outputs/worklist_triage.json

# Portalocker sidecar lock files (safe_json). These exist alongside the
# real JSON — presence is semantic-free, content is empty.
*.lock

# Lifetime cost ledger — personal, per-machine counter. Don't sync across
# machines (would merge-conflict on every pull). Each machine keeps its
# own totals.
data/lifetime_cost.json
data/lifetime_cost.*.json

# Caches — can grow to many MB of JD text; regenerate on demand
automation/outputs/jd_cache/
automation/outputs/fit_cache/

# resume_render.py transients. The finished deliverables under applications/
# are intentionally TRACKED (synced across machines); these are scratch only:
#   *.pdf.tmp        — atomic-replace staging file (should never persist)
#   *_preview.pdf / _audit_preview.pdf — ad-hoc render previews dropped into
#     the resume_data/ INPUT dir; not deliverables. (Already-committed
#     _audit_preview.pdf stays tracked; this stops NEW previews from leaking.)
applications/**/*.pdf.tmp
automation/resume_data/*_preview.pdf

# ============================================================================
# Tracker / CRM backups — written by auto_promote and the UI
# ============================================================================
job_tracker_data.bak*.json
recruiter_crm.bak*.json
data/job_tracker_data.bak*.json
data/recruiter_crm.bak*.json

# ============================================================================
# Suppressions — live state, audit log, history, recovery queue
# Reasons can be candid; never sync across machines. Seed via
# data/suppressions.example.json (which IS committed).
# ============================================================================
data/suppressions.json
data/suppressions_events.jsonl
data/suppressions_history.json
data/suppressions_pending_archives.jsonl

# ============================================================================
# Excluded companies — permanent source-level block (live state only).
# Per-machine; seed via data/excludes.example.json (which IS committed).
# ============================================================================
data/excludes.json

# ============================================================================
# App runtime logs — written by start.ps1
# ============================================================================
logs/

# ============================================================================
# Secrets — NEVER commit
# ============================================================================
.env
*.key
secrets.json
# Gmail / OAuth artifacts (if any adapter writes them in-repo — shouldn't,
# but defense-in-depth):
credentials.json
token.json
automation/credentials/

# ============================================================================
# But DO keep a placeholder so outputs/ exists after clone
# ============================================================================
!automation/outputs/.gitkeep
