# ApplyAgent — environment variables
#
# Copy this file to `.env` (same directory) and fill in your real values:
#     cp .env.example .env
#
# `.env` is gitignored — your real keys never enter the repo or chat.
#
# Load into the current shell:
#     bash:        set -a && source .env && set +a
#     PowerShell:  Get-Content .env | foreach { $name, $value = $_ -split '=', 2; if ($name -and -not $name.StartsWith('#')) { [Environment]::SetEnvironmentVariable($name, $value.Trim('"'), 'Process') } }
#     One-liner:   python automation/load_env.py    # loads .env into current python session for subprocesses
#
# Or use the Streamlit UI sidebar — it reads ~/.applyagent/config.json instead.

# Anthropic API key — required for fit_scorer, jd_tailor, score_url
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Model overrides (optional — defaults are sensible)
# FIT_SCORER_MODEL="claude-haiku-4-5-20251001"
# FIT_SCORER_FALLBACK_MODEL="claude-sonnet-4-6"
# JD_TAILOR_MODEL="claude-opus-4-7"
# JD_TAILOR_FALLBACK="claude-sonnet-4-6"

# Cost guard caps (optional — defaults: $5/day, $2/run)
# COST_GUARD_DAILY_CAP_USD="5.0"
# COST_GUARD_PER_RUN_CAP_USD="2.0"

# Skip the API preflight (CI / debugging only — not for normal use)
# APPLYAGENT_SKIP_PREFLIGHT="1"
